{
  "manifest_version": 3,
  "name": "X-Flow - X 智流推特 (AI 智译与 Obsidian 剪藏)",
  "version": "1.1.0",
  "description": "为 X (Twitter) 赋予 DeepSeek 实时流式翻译、AI 深度解读与一键存入本地 Obsidian 知识库的能力。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://pbs.twimg.com/*",
    "https://video.twimg.com/*",
    "https://ton.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
